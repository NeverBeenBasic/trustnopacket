<script>
const canvas = document.getElementById('net-canvas');
const ctx = canvas.getContext('2d');
const COLORS = { bg: '#111418', node: { firewall: '#2c7be5', server: '#22c55e', endpoint: '#8a95a8', dc: '#daa520', compromised: '#ef4444' }, edge: 'rgba(44,123,229,0.18)', scan: '#daa520', attack: '#ef4444', packet: '#22c55e' };
const NODE_TYPES = ['firewall','dc','server','server','endpoint','endpoint','endpoint','endpoint','endpoint','endpoint'];
const LABELS = ['FW-01','DC-01','SRV-01','SRV-02','EP-01','EP-02','EP-03','EP-04','EP-05','EP-06'];
let nodes = [], edges = [], particles = [], threats = 0, scanning = false, W, H;
function resize() { const dpr = window.devicePixelRatio || 1; const rect = canvas.getBoundingClientRect(); W = rect.width; H = rect.height; canvas.width = W * dpr; canvas.height = H * dpr; ctx.scale(dpr, dpr); }
function initNodes() {
  nodes = []; edges = []; particles = []; threats = 0;
  const cx = W/2, cy = H/2;
  const rings = [[0,0,1],[140,0,3],[240,0,6]];
  let idx = 0;
  rings.forEach(([r, startAngle, count]) => { for (let i = 0; i < count && idx < NODE_TYPES.length; i++, idx++) { const angle = startAngle + (i/count)*Math.PI*2; nodes.push({ id: idx, x: cx+Math.cos(angle)*r, y: cy+Math.sin(angle)*r, type: NODE_TYPES[idx], label: LABELS[idx], status: 'normal', pulse: 0 }); } });
  for (let i = 1; i < nodes.length; i++) edges.push({ a: 0, b: i });
  edges.push({ a: 1, b: 2 }, { a: 1, b: 3 }, { a: 2, b: 4 }, { a: 3, b: 7 });
  updateStats();
}
function updateStats() { document.getElementById('stat-nodes').textContent = nodes.length; document.getElementById('stat-threats').textContent = threats; const comp = nodes.filter(n => n.status==='compromised').length; const el = document.getElementById('stat-status'); if (comp===0){el.textContent='Secure';el.style.color='var(--green)';}else if(comp<3){el.textContent='Warning';el.style.color='var(--gold)';}else{el.textContent='Breach';el.style.color='var(--red)';} }
function spawnParticle(from, to, color, onArrive) { particles.push({ x: from.x, y: from.y, tx: to.x, ty: to.y, progress: 0, speed: 0.022+Math.random()*0.01, color, onArrive }); }
function nodeColor(n) { if(n.status==='compromised') return COLORS.node.compromised; if(n.status==='scanning') return COLORS.scan; return COLORS.node[n.type]||COLORS.node.endpoint; }
function nodeRadius(n) { return n.type==='firewall'?16:n.type==='dc'?13:n.type==='server'?11:8; }
function draw() {
  ctx.clearRect(0,0,W,H);
  edges.forEach(e => { const a=nodes[e.a],b=nodes[e.b]; ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.strokeStyle=COLORS.edge; ctx.lineWidth=0.8; ctx.stroke(); });
  particles.forEach(p => { p.progress=Math.min(1,p.progress+p.speed); p.x=p.x+(p.tx-p.x)*p.speed*2; p.y=p.y+(p.ty-p.y)*p.speed*2; ctx.beginPath(); ctx.arc(p.x,p.y,3,0,Math.PI*2); ctx.fillStyle=p.color; ctx.globalAlpha=1-p.progress*0.5; ctx.fill(); ctx.globalAlpha=1; if(p.progress>=0.98&&p.onArrive){p.onArrive();p.onArrive=null;} });
  particles=particles.filter(p=>p.progress<1);
  nodes.forEach(n => {
    if(n.pulse>0){ctx.beginPath();ctx.arc(n.x,n.y,nodeRadius(n)+n.pulse*18,0,Math.PI*2);ctx.strokeStyle=nodeColor(n);ctx.globalAlpha=(1-n.pulse)*0.4;ctx.lineWidth=1;ctx.stroke();ctx.globalAlpha=1;n.pulse=Math.min(1,n.pulse+0.025);if(n.pulse>=1)n.pulse=0;}
    ctx.beginPath();ctx.arc(n.x,n.y,nodeRadius(n),0,Math.PI*2);ctx.fillStyle=nodeColor(n)+'22';ctx.fill();ctx.strokeStyle=nodeColor(n);ctx.lineWidth=1.5;ctx.stroke();
    ctx.fillStyle=nodeColor(n);ctx.font='9px DM Mono, monospace';ctx.textAlign='center';ctx.fillText(n.label,n.x,n.y+nodeRadius(n)+12);
  });
  requestAnimationFrame(draw);
}
function doPortScan() { if(scanning)return;scanning=true;nodes.forEach(n=>{if(n.type!=='firewall')n.status='scanning';});let i=0;const scanNext=()=>{if(i>=nodes.length){setTimeout(()=>{nodes.forEach(n=>{if(n.status==='scanning')n.status='normal';});scanning=false;updateStats();},400);return;}const n=nodes[i++];n.pulse=0.01;spawnParticle(nodes[0],n,COLORS.scan,()=>{});setTimeout(scanNext,120);};scanNext(); }
function doAttack() { const fw=nodes[0];const targets=nodes.filter(n=>n.type!=='firewall'&&n.status!=='compromised');if(!targets.length)return;const t=targets[Math.floor(Math.random()*targets.length)];t.status='compromised';t.pulse=0.01;threats++;spawnParticle(fw,t,COLORS.attack,()=>{if(Math.random()>0.5){const neighbors=edges.filter(e=>e.a===t.id||e.b===t.id).map(e=>e.a===t.id?nodes[e.b]:nodes[e.a]).filter(n=>n.status!=='compromised');if(neighbors.length){const n2=neighbors[Math.floor(Math.random()*neighbors.length)];setTimeout(()=>{n2.status='compromised';n2.pulse=0.01;threats++;spawnParticle(t,n2,COLORS.attack,()=>{updateStats();});updateStats();},600);}}updateStats();});updateStats(); }
function doReset() { initNodes(); }
document.getElementById('btn-scan').addEventListener('click', doPortScan);
document.getElementById('btn-attack').addEventListener('click', doAttack);
document.getElementById('btn-reset').addEventListener('click', doReset);
window.addEventListener('resize', ()=>{ resize(); initNodes(); });
resize(); initNodes(); requestAnimationFrame(draw);
</script>

